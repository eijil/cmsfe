  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "import": "./dist/env.js",
      "require": "./dist/env.cjs"
    },
    "./service": {
      "types": "./dist/service/index.d.ts",
      "import": "./dist/service/index.js",
      "require": "./dist/service/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint"
  },
  "devDependencies": {
    "@vitest/browser": "^1.6.0",
    "tsup": "^8.0.2",
    "typescript": "latest",
    "vite": "^5.2.13",
    "webdriverio": "^8.38.2",
    "@types/crypto-js": "^4.2.2",
    "@types/pako": "^2.0.3",
    "@types/ua-parser-js": "^0.7.39"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    
    "buffer": "^6.0.3",
    "crypto-js": "^4.2.0",
    "fflate": "^0.8.2",
    "js-base64": "^3.7.7",
    "jsencrypt": "^3.3.2",
    "nanoid": "^5.0.7",
    "pako": "^2.1.0",
    "ua-parser-js": "^1.0.38"
